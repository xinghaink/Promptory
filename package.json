{
  "name": "promptory",
  "description": "本地优先、跨 AI 平台的个人提示词库",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "wxt",
    "build": "wxt build",
    "zip": "wxt zip",
